# Copy this file to .env and enter your own key. Never upload .env to GitHub.
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
# Set a long random value when deploying. The default in app.py is for local tests only.
# FLASK_SECRET_KEY=your-long-random-secret

# MongoDB Atlas: keep this password and URI private.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ithaca
# Optional for production: generate a long random value and keep it private.
# FLASK_SECRET_KEY=CHANGE_ME
